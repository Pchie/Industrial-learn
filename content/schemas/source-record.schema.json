{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industriallearn.local/schemas/source-record.schema.json",
  "title": "Industrial Learn Source Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "documentType",
    "citation",
    "approvalStatus",
    "reviewStatus",
    "evidenceStatus",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "fullTitle": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "organisation": { "type": "string", "minLength": 1 },
    "edition": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "publicationDate": { "type": "string", "minLength": 1 },
    "accessDate": { "type": "string", "minLength": 1 },
    "documentType": { "type": "string", "minLength": 1 },
    "citation": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "filePath": { "type": ["string", "null"] },
    "accessMode": {
      "type": "string",
      "enum": ["local-file", "metadata-only"]
    },
    "copyrightStatus": { "type": "string", "minLength": 1 },
    "authorityLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
    "authorityCategory": {
      "type": "string",
      "enum": [
        "governing-authoritative",
        "official-technical-documentation",
        "university-engineering-textbook",
        "university-peer-reviewed-educational",
        "supporting"
      ]
    },
    "sourceSelection": {
      "type": "object",
      "required": ["role", "rationale"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["governing", "primary", "corroborating", "supporting"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "preferredAcademicPublisherAssessment": {
          "type": "object",
          "required": ["applicable", "outcome", "rationale"],
          "properties": {
            "applicable": { "type": "boolean" },
            "outcome": {
              "type": "string",
              "enum": [
                "mcgraw-hill-selected",
                "equivalent-source-selected",
                "preferred-source-not-legally-available",
                "preferred-source-insufficient",
                "not-applicable-to-source-role"
              ]
            },
            "rationale": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "required": ["knowledgeFileIds", "equationIds", "simulationIds"],
      "properties": {
        "knowledgeFileIds": { "type": "array", "items": { "type": "string" } },
        "equationIds": { "type": "array", "items": { "type": "string" } },
        "simulationIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "conflicts": {
      "type": "object",
      "required": ["status", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none-recorded", "documented", "unresolved"]
        },
        "notes": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "publisher": { "type": "string", "minLength": 1 },
    "isbn": { "type": "string", "minLength": 1 },
    "reviewer": { "type": ["string", "null"] },
    "reviewDate": { "type": ["string", "null"] },
    "relevantChapters": { "type": "array", "items": { "type": "string" } },
    "relevantSections": { "type": "array", "items": { "type": "string" } },
    "relevantPages": { "type": "array", "items": { "type": "string" } },
    "rights": {
      "type": "object",
      "properties": {
        "licence": { "type": "string" },
        "permittedInternalUse": { "type": "string" },
        "mayDistribute": { "type": "boolean" },
        "metadataOnly": { "type": "boolean" },
        "studentMayOpenDirectly": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "documentOpened": { "type": "boolean" },
        "metadataVerified": { "type": "boolean" },
        "verifiedAt": { "type": "string" },
        "verificationMethod": { "type": "string" },
        "fixedPageCount": { "type": ["integer", "null"] },
        "sha256": { "type": ["string", "null"] },
        "containsEmbeddedJavaScript": { "type": "boolean" }
      }
    },
    "approvalStatus": { "$ref": "#/$defs/reviewStatus" },
    "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
    "evidenceStatus": {
      "type": "string",
      "enum": ["missing", "partial", "approved"]
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidenceStatus": { "const": "approved" } },
        "required": ["evidenceStatus"]
      },
      "then": {
        "required": [
          "author",
          "organisation",
          "version",
          "publicationDate",
          "accessDate",
          "copyrightStatus",
          "authorityLevel",
          "authorityCategory",
          "sourceSelection",
          "traceability",
          "conflicts",
          "rights",
          "reviewer",
          "reviewDate",
          "verification",
          "relevantSections",
          "limitations"
        ]
      }
    },
    {
      "if": {
        "properties": { "authorityLevel": { "const": 1 } },
        "required": ["authorityLevel"]
      },
      "then": {
        "properties": { "authorityCategory": { "const": "governing-authoritative" } }
      }
    },
    {
      "if": {
        "properties": { "authorityLevel": { "const": 2 } },
        "required": ["authorityLevel"]
      },
      "then": {
        "properties": {
          "authorityCategory": { "const": "official-technical-documentation" }
        }
      }
    },
    {
      "if": {
        "properties": { "authorityLevel": { "const": 3 } },
        "required": ["authorityLevel"]
      },
      "then": {
        "required": ["publisher", "edition", "publicationDate"],
        "properties": {
          "authorityCategory": { "const": "university-engineering-textbook" }
        }
      }
    },
    {
      "if": {
        "properties": { "authorityLevel": { "const": 4 } },
        "required": ["authorityLevel"]
      },
      "then": {
        "properties": {
          "authorityCategory": { "const": "university-peer-reviewed-educational" }
        }
      }
    },
    {
      "if": {
        "properties": { "authorityLevel": { "const": 5 } },
        "required": ["authorityLevel"]
      },
      "then": { "properties": { "authorityCategory": { "const": "supporting" } } }
    }
  ],
  "$defs": {
    "reviewStatus": {
      "type": "string",
      "enum": [
        "Draft",
        "Source required",
        "Source checked",
        "Equation checked",
        "Simulation checked",
        "Engineering review required",
        "Approved for student use"
      ]
    }
  }
}
