{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industriallearn.local/schemas/source-record.schema.json",
  "title": "Industrial Learn Source Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "documentType",
    "citation",
    "approvalStatus",
    "reviewStatus",
    "evidenceStatus",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "fullTitle": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "organisation": { "type": "string", "minLength": 1 },
    "edition": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "publicationDate": { "type": "string", "minLength": 1 },
    "accessDate": { "type": "string", "minLength": 1 },
    "documentType": { "type": "string", "minLength": 1 },
    "citation": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "filePath": { "type": ["string", "null"] },
    "accessMode": {
      "type": "string",
      "enum": ["local-file", "metadata-only"]
    },
    "copyrightStatus": { "type": "string", "minLength": 1 },
    "reliabilityLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
    "reviewer": { "type": ["string", "null"] },
    "reviewDate": { "type": ["string", "null"] },
    "relevantChapters": { "type": "array", "items": { "type": "string" } },
    "relevantSections": { "type": "array", "items": { "type": "string" } },
    "relevantPages": { "type": "array", "items": { "type": "string" } },
    "rights": {
      "type": "object",
      "properties": {
        "licence": { "type": "string" },
        "permittedInternalUse": { "type": "string" },
        "mayDistribute": { "type": "boolean" },
        "metadataOnly": { "type": "boolean" },
        "studentMayOpenDirectly": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "documentOpened": { "type": "boolean" },
        "metadataVerified": { "type": "boolean" },
        "verifiedAt": { "type": "string" },
        "verificationMethod": { "type": "string" },
        "fixedPageCount": { "type": ["integer", "null"] },
        "sha256": { "type": ["string", "null"] },
        "containsEmbeddedJavaScript": { "type": "boolean" }
      }
    },
    "approvalStatus": { "$ref": "#/$defs/reviewStatus" },
    "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
    "evidenceStatus": {
      "type": "string",
      "enum": ["missing", "partial", "approved"]
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "$defs": {
    "reviewStatus": {
      "type": "string",
      "enum": [
        "Draft",
        "Source required",
        "Source checked",
        "Equation checked",
        "Simulation checked",
        "Engineering review required",
        "Approved for student use"
      ]
    }
  }
}
