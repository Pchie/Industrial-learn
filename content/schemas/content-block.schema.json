{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industriallearn.local/schemas/content-block.schema.json",
  "title": "Industrial Learn Lesson Content Block",
  "oneOf": [
    { "$ref": "#/$defs/paragraph" },
    { "$ref": "#/$defs/definition" },
    { "$ref": "#/$defs/diagram" },
    { "$ref": "#/$defs/equation" },
    { "$ref": "#/$defs/symbolTable" },
    { "$ref": "#/$defs/unitNote" },
    { "$ref": "#/$defs/assumption" },
    { "$ref": "#/$defs/workedCalculation" },
    { "$ref": "#/$defs/engineeringInterpretation" },
    { "$ref": "#/$defs/warning" },
    { "$ref": "#/$defs/faultCase" },
    { "$ref": "#/$defs/question" },
    { "$ref": "#/$defs/sourceCitation" },
    { "$ref": "#/$defs/heroSimulation" },
    { "$ref": "#/$defs/interactiveDiagram" },
    { "$ref": "#/$defs/animation" },
    { "$ref": "#/$defs/observationQuestion" },
    { "$ref": "#/$defs/microTheory" },
    { "$ref": "#/$defs/liveEquation" },
    { "$ref": "#/$defs/componentCutaway" },
    { "$ref": "#/$defs/linkedSchematic" },
    { "$ref": "#/$defs/engineeringChallenge" },
    { "$ref": "#/$defs/faultChallenge" },
    { "$ref": "#/$defs/realWorldApplication" },
    { "$ref": "#/$defs/deepDive" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "sourceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "symbol": {
      "type": "object",
      "required": ["symbol", "name", "unit"],
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" }
      }
    },
    "reviewStatus": {
      "enum": [
        "Draft",
        "Source required",
        "Source checked",
        "Equation checked",
        "Simulation checked",
        "Engineering review required",
        "Approved for student use"
      ]
    },
    "accessibility": {
      "type": "object",
      "required": [
        "label",
        "textAlternative",
        "keyboardInstructions",
        "reducedMotionFallback"
      ],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "textAlternative": { "type": "string", "minLength": 1 },
        "keyboardInstructions": { "type": "string", "minLength": 1 },
        "reducedMotionFallback": { "type": "string", "minLength": 1 }
      }
    },
    "challengePattern": {
      "enum": ["target", "constraint", "diagnosis", "design"]
    },
    "challengeFeedback": {
      "type": "object",
      "required": ["beforeCheck", "onSuccess", "onIncomplete"],
      "properties": {
        "beforeCheck": { "type": "string", "minLength": 1 },
        "onSuccess": { "type": "string", "minLength": 1 },
        "onIncomplete": { "type": "string", "minLength": 1 }
      }
    },
    "visualBase": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": [
            "title",
            "description",
            "sourceIds",
            "reviewStatus",
            "accessibility"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
            "accessibility": { "$ref": "#/$defs/accessibility" }
          }
        }
      ]
    },
    "paragraph": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "type": { "const": "paragraph" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "definition": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["term", "definition"],
          "properties": {
            "type": { "const": "definition" },
            "term": { "type": "string" },
            "definition": { "type": "string" }
          }
        }
      ]
    },
    "diagram": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["title", "altText", "description"],
          "properties": {
            "type": { "const": "diagram" },
            "title": { "type": "string" },
            "altText": { "type": "string" },
            "description": { "type": "string" },
            "caption": { "type": "string" }
          }
        }
      ]
    },
    "equation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["name", "expression", "symbols"],
          "properties": {
            "type": { "const": "equation" },
            "name": { "type": "string" },
            "expression": { "type": "string" },
            "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } }
          }
        }
      ]
    },
    "symbolTable": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["symbols"],
          "properties": {
            "type": { "const": "symbolTable" },
            "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } }
          }
        }
      ]
    },
    "unitNote": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["quantity", "siUnit", "note"],
          "properties": {
            "type": { "const": "unitNote" },
            "quantity": { "type": "string" },
            "siUnit": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "assumption": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "type": { "const": "assumption" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "workedCalculation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["title", "given", "steps", "result", "interpretation"],
          "properties": {
            "type": { "const": "workedCalculation" },
            "title": { "type": "string" },
            "given": { "type": "array", "items": { "type": "string" } },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "explanation"],
                "properties": {
                  "label": { "type": "string" },
                  "expression": { "type": "string" },
                  "explanation": { "type": "string" }
                }
              }
            },
            "result": { "type": "string" },
            "interpretation": { "type": "string" }
          }
        }
      ]
    },
    "engineeringInterpretation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "type": { "const": "engineeringInterpretation" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "warning": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["title", "text", "severity"],
          "properties": {
            "type": { "const": "warning" },
            "title": { "type": "string" },
            "text": { "type": "string" },
            "severity": { "enum": ["info", "warning", "fault"] }
          }
        }
      ]
    },
    "faultCase": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["title", "symptoms", "likelyCauses", "safeResponse"],
          "properties": {
            "type": { "const": "faultCase" },
            "title": { "type": "string" },
            "symptoms": { "type": "array", "items": { "type": "string" } },
            "likelyCauses": { "type": "array", "items": { "type": "string" } },
            "safeResponse": { "type": "string" }
          }
        }
      ]
    },
    "question": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["prompt", "options", "answerExplanation"],
          "properties": {
            "type": { "const": "question" },
            "prompt": { "type": "string" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "text", "isCorrect"],
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" },
                  "isCorrect": { "type": "boolean" }
                }
              }
            },
            "answerExplanation": { "type": "string" }
          }
        }
      ]
    },
    "sourceCitation": {
      "type": "object",
      "required": ["id", "type", "sourceId", "note"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "sourceCitation" },
        "sourceId": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "heroSimulation": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["simulationId", "mode"],
          "properties": {
            "type": { "const": "heroSimulation" },
            "simulationId": { "type": "string", "pattern": "^SIM-[A-Z0-9-]+$" },
            "mode": {
              "enum": [
                "learn",
                "guided",
                "explore",
                "fault-diagnosis",
                "assessment",
                "demonstration"
              ]
            }
          }
        }
      ]
    },
    "interactiveDiagram": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["diagramId", "componentIds"],
          "properties": {
            "type": { "const": "interactiveDiagram" },
            "diagramId": { "type": "string", "pattern": "^DIAG-[A-Z0-9-]+$" },
            "componentIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "animation": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["animationId"],
          "properties": {
            "type": { "const": "animation" },
            "animationId": { "type": "string", "pattern": "^ANIM-[A-Z0-9-]+$" }
          }
        }
      ]
    },
    "observationQuestion": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["prompt", "graded"],
          "properties": {
            "type": { "const": "observationQuestion" },
            "prompt": { "type": "string", "minLength": 1 },
            "hint": { "type": "string" },
            "explanation": { "type": "string" },
            "graded": { "const": false }
          }
        }
      ]
    },
    "microTheory": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["principle"],
          "properties": {
            "type": { "const": "microTheory" },
            "principle": { "type": "string", "minLength": 1 },
            "expandedExplanation": { "type": "string" },
            "safetyInformation": { "type": "string" }
          }
        }
      ]
    },
    "liveEquation": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["equationId", "inputBindings", "outputBinding"],
          "properties": {
            "type": { "const": "liveEquation" },
            "equationId": { "type": "string", "pattern": "^EQ-[A-Z0-9-]+$" },
            "inputBindings": { "type": "object", "minProperties": 1 },
            "outputBinding": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "componentCutaway": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["componentId", "representations"],
          "properties": {
            "type": { "const": "componentCutaway" },
            "componentId": { "type": "string", "minLength": 1 },
            "representations": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["external", "cutaway", "schematic"] },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "linkedSchematic": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["simulationId", "componentIds"],
          "properties": {
            "type": { "const": "linkedSchematic" },
            "simulationId": { "type": "string", "pattern": "^SIM-[A-Z0-9-]+$" },
            "componentIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "engineeringChallenge": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": [
            "challengeId",
            "objective",
            "pattern",
            "goal",
            "allowedActions",
            "successCondition",
            "feedback",
            "modelAssumptions"
          ],
          "properties": {
            "type": { "const": "engineeringChallenge" },
            "challengeId": { "type": "string", "pattern": "^CH-[A-Z0-9-]+$" },
            "objective": { "type": "string", "minLength": 1 },
            "pattern": { "$ref": "#/$defs/challengePattern" },
            "goal": { "type": "string", "minLength": 1 },
            "allowedActions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "successCondition": { "type": "string", "minLength": 1 },
            "feedback": { "$ref": "#/$defs/challengeFeedback" },
            "modelAssumptions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "faultChallenge": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": [
            "simulationId",
            "faultId",
            "pattern",
            "goal",
            "allowedActions",
            "successCondition",
            "feedback",
            "modelAssumptions"
          ],
          "properties": {
            "type": { "const": "faultChallenge" },
            "simulationId": { "type": "string", "pattern": "^SIM-[A-Z0-9-]+$" },
            "faultId": { "type": "string", "pattern": "^FAULT-[A-Z0-9-]+$" },
            "pattern": { "const": "diagnosis" },
            "goal": { "type": "string", "minLength": 1 },
            "allowedActions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "successCondition": { "type": "string", "minLength": 1 },
            "feedback": { "$ref": "#/$defs/challengeFeedback" },
            "modelAssumptions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "realWorldApplication": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["applicationId", "systemType", "principle"],
          "properties": {
            "type": { "const": "realWorldApplication" },
            "applicationId": { "type": "string", "pattern": "^APP-[A-Z0-9-]+$" },
            "systemType": { "type": "string", "minLength": 1 },
            "principle": { "type": "string", "minLength": 1 },
            "relatedSimulationId": {
              "type": "string",
              "pattern": "^SIM-[A-Z0-9-]+$"
            }
          }
        }
      ]
    },
    "deepDive": {
      "allOf": [
        { "$ref": "#/$defs/visualBase" },
        {
          "type": "object",
          "required": ["content"],
          "properties": {
            "type": { "const": "deepDive" },
            "content": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
