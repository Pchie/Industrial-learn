{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industriallearn.local/schemas/lesson.schema.json",
  "title": "Industrial Learn Lesson",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "description",
    "publicationStatus",
    "reviewStatus",
    "version",
    "estimatedCompletionTime",
    "difficulty",
    "prerequisites",
    "knowledgeFileIds",
    "sourceIds",
    "learningOutcomes",
    "requiredSections",
    "sections",
    "quizIds",
    "projectIds"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^LES-[A-Z0-9-]+$" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "experienceModel": { "enum": ["linear-v1", "visual-v2"] },
    "visualLessonType": { "type": "string" },
    "lessonType": { "$ref": "#/$defs/lessonType" },
    "visualStandardVersion": { "const": "1.0.0" },
    "visualMetadata": { "$ref": "#/$defs/visualMetadata" },
    "simulationIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SIM-[A-Z0-9-]+$" }
    },
    "publicationStatus": {
      "enum": ["draft", "internal", "scheduled", "published", "archived"]
    },
    "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
    "version": { "type": "string" },
    "authorProfileId": { "type": "string", "minLength": 1 },
    "knowledgeFileIds": { "type": "array", "items": { "type": "string" } },
    "sourceIds": { "type": "array", "items": { "type": "string" } },
    "learningOutcomes": { "type": "array", "items": { "type": "string" } },
    "estimatedCompletionTime": { "type": "string" },
    "estimatedInteractionTime": { "type": "string" },
    "difficulty": { "type": "string" },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "requiredSections": {
      "type": "array",
      "items": { "$ref": "#/$defs/requiredSectionId" },
      "contains": { "const": "lessonHeader" }
    },
    "sections": {
      "type": "object",
      "required": [
        "lessonHeader",
        "estimatedCompletionTime",
        "difficulty",
        "prerequisites",
        "learningOutcomes",
        "whyTopicMatters",
        "keyTerminology",
        "visualExplanation",
        "theory",
        "equations",
        "workedExamples",
        "interactiveActivity",
        "faultFindingExercise",
        "safetyConsiderations",
        "knowledgeCheck",
        "summary",
        "sources",
        "nextRecommendedLesson"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["title", "blocks"],
        "properties": {
          "title": { "type": "string" },
          "blocks": {
            "type": "array",
            "items": { "$ref": "content-block.schema.json" }
          }
        }
      }
    },
    "experienceSequence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/visualStage" }
    },
    "equationIds": { "type": "array", "items": { "type": "string" } },
    "workedExampleIds": { "type": "array", "items": { "type": "string" } },
    "faultScenarioIds": { "type": "array", "items": { "type": "string" } },
    "safetyWarningIds": { "type": "array", "items": { "type": "string" } },
    "quizIds": { "type": "array", "items": { "type": "string" } },
    "relatedApplications": { "type": "array", "items": { "type": "string" } },
    "relatedAssessmentIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ASM-[A-Z0-9-]+$" }
    },
    "projectIds": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "reviewStatus": { "const": "Approved for student use" }
            },
            "required": ["reviewStatus"]
          },
          {
            "properties": { "publicationStatus": { "const": "published" } },
            "required": ["publicationStatus"]
          }
        ]
      },
      "then": { "required": ["authorProfileId"] }
    }
  ],
  "$defs": {
    "lessonType": {
      "enum": [
        "phenomenon",
        "component",
        "system",
        "calculation",
        "diagnostic",
        "design",
        "theory"
      ]
    },
    "visualMetadata": {
      "type": "object",
      "required": ["firstScreen", "progression", "inputs", "outputs"],
      "properties": {
        "firstScreen": {
          "type": "object",
          "required": ["purpose", "primaryVisualBlockId", "primaryControlIds"],
          "properties": {
            "purpose": { "type": "string", "minLength": 1 },
            "primaryVisualBlockId": { "type": "string", "minLength": 1 },
            "primaryControlIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "progression": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["see", "play", "calculate", "challenge", "apply", "check"]
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/simulationInput" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/simulationOutput" }
        }
      }
    },
    "simulationInput": {
      "type": "object",
      "required": [
        "id",
        "label",
        "quantity",
        "unit",
        "internalUnit",
        "default",
        "minimum",
        "maximum",
        "step",
        "validation",
        "modelValidityRange",
        "accessibilityLabel",
        "educationalDescription"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "internalUnit": { "type": "string", "minLength": 1 },
        "default": { "type": "number" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "validation": { "type": "string", "minLength": 1 },
        "modelValidityRange": {
          "type": "object",
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" }
          }
        },
        "accessibilityLabel": { "type": "string", "minLength": 1 },
        "educationalDescription": { "type": "string", "minLength": 1 }
      }
    },
    "simulationOutput": {
      "type": "object",
      "required": [
        "id",
        "label",
        "quantity",
        "unit",
        "internalUnit",
        "interpretation",
        "validityState",
        "measurementSource"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "internalUnit": { "type": "string", "minLength": 1 },
        "interpretation": { "type": "string", "minLength": 1 },
        "validityState": { "enum": ["valid", "warning", "invalid", "unavailable"] },
        "warning": { "type": "string" },
        "measurementSource": { "type": "string", "minLength": 1 }
      }
    },
    "visualStage": {
      "type": "object",
      "required": ["stage", "title", "blocks"],
      "properties": {
        "stage": {
          "enum": [
            "heroExperience",
            "explore",
            "observe",
            "microTheory",
            "liveEquation",
            "engineeringChallenge",
            "faultMode",
            "realWorldApplication",
            "knowledgeCheck",
            "deepDive",
            "sources"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "content-block.schema.json" }
        }
      }
    },
    "requiredSectionId": {
      "type": "string",
      "enum": [
        "lessonHeader",
        "estimatedCompletionTime",
        "difficulty",
        "prerequisites",
        "learningOutcomes",
        "whyTopicMatters",
        "keyTerminology",
        "visualExplanation",
        "theory",
        "equations",
        "workedExamples",
        "interactiveActivity",
        "faultFindingExercise",
        "safetyConsiderations",
        "knowledgeCheck",
        "summary",
        "sources",
        "nextRecommendedLesson"
      ]
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "Draft",
        "Source required",
        "Source checked",
        "Equation checked",
        "Simulation checked",
        "Engineering review required",
        "Approved for student use"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "experienceModel": { "const": "visual-v2" } },
        "required": ["experienceModel"]
      },
      "then": {
        "required": [
          "schemaVersion",
          "experienceSequence",
          "lessonType",
          "visualStandardVersion",
          "visualMetadata"
        ],
        "properties": {
          "lessonType": {
            "enum": [
              "phenomenon",
              "component",
              "system",
              "calculation",
              "diagnostic",
              "design"
            ]
          }
        }
      }
    }
  ]
}
