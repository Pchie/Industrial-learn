# Industrial Learn staging environment template
# Store real values only in the approved hosting or secret manager.
# Do not commit a filled staging environment file.

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=staging
APP_BASE_URL=

# Browser-safe public Supabase values for the dedicated staging project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values for the dedicated staging project.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Staging must use Supabase authentication, not local test authentication.
INDUSTRIAL_LEARN_AUTH_MODE=supabase
INDUSTRIAL_LEARN_E2E=false
