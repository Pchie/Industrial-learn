# Industrial Learn environment example
# Copy to .env.local for local development.

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
APP_VERSION=0.1.0

# Public browser-safe Supabase values.
# These prepare the PostgreSQL-compatible Supabase integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase value. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only deployment and migration values. Never expose these to the browser.
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Local Playwright-only authentication mode.
# Staging and production must not use local auth.
INDUSTRIAL_LEARN_AUTH_MODE=supabase
INDUSTRIAL_LEARN_E2E=false
